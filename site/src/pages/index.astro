---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/Base.astro';

// Try to grab index.md
const entry = await getEntry('docs', 'index');
if (!entry) throw new Error("Could not find index.md!");
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="hero" style="text-align: center; margin: 3rem 0;">
    <h1 style="font-size: 3rem; color: var(--accent-color); margin-bottom: 0.5rem;">{entry.data.title}</h1>
    <p style="font-size: 1.25rem; color: var(--text-color); max-width: 600px; margin: 0 auto; margin-bottom: 2rem;">{entry.data.description}</p>
    
    <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/installation" style="background-color: var(--accent-color); color: #000; padding: 0.75rem 1.5rem; border-radius: 6px; font-weight: 600; text-decoration: none;">Build &amp; Run ulti</a>
        <a href="/how-it-works" style="background-color: var(--highlight-bg); color: var(--text-color); padding: 0.75rem 1.5rem; border-radius: 6px; outline: 1px solid var(--border-color); font-weight: 500; text-decoration: none;">How It Works</a>
    </div>

    <div style="max-width: 650px; margin: 2.5rem auto 0; text-align: left;">
      <pre><code>$ ulti "install ripgrep and fd"
Platform: Ubuntu (apt-get)

Already installed:
  ✓ ripgrep (rg) — ripgrep 14.1.0

Missing (will install):
  • fd -&gt; package 'fd-find' (executable: 'fdfind')

Command to run:
  sudo apt-get install -y fd-find

Proceed with installation? [y/N]: y
Running: sudo apt-get install -y fd-find

Verification:
  ✓ fd (fdfind) — fdfind 9.0.0
  ✓ ripgrep (rg) — ripgrep 14.1.0</code></pre>
    </div>
  </div>
  
  <div class="content" style="font-size: 1.1rem; max-width: 650px; margin: 0 auto; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
    <Content />
  </div>
</BaseLayout>
